{
  "compilerOptions": {
    "target": "ES6",
    "lib": ["ES2017", "DOM"],
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "figma-plugin/dist",
    "rootDir": "figma-plugin/src",
    "skipLibCheck": true,
    "types": ["@figma/plugin-typings"]
  },
  "include": ["figma-plugin/src/**/*"]
}
