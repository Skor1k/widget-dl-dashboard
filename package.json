{
  "name": "my-project",
  "version": "1.0.0",
  "private": true,
  "homepage": "https://Skor1k.github.io/widget-dl-dashboard",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "build:plugin": "esbuild figma-plugin/src/code.ts --bundle --platform=browser --target=es6 --outfile=figma-plugin/dist/code.js && cp figma-plugin/src/ui.html figma-plugin/dist/ui.html",
    "generate:figma": "ts-node --project tsconfig.scripts.json scripts/generate-page.ts",
    "test:scripts": "jest --config jest.config.scripts.js",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "dependencies": {
    "@adv-frontend/l10n": "^1.4.1",
    "@direct-frontend/components": "^0.16.1",
